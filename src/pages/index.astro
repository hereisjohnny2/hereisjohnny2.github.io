---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="Home">
    <section class="grid items-end gap-10 lg:grid-cols-[1.2fr_0.8fr]">
        <div>
            <p
                class="mb-5 text-sm font-bold tracking-[0.2em] text-(--accent-dark) uppercase"
            >
                Programação · Carros · Música · Livros
            </p>
            <h1
                class="max-w-3xl font-serif text-6xl leading-[0.9] tracking-tight text-(--ink) sm:text-8xl"
            >
                Seja bem-vindo ao meu cantinho<span class="text-(--accent)"
                    >.</span
                >
            </h1>
            <p
                class="mt-8 max-w-xl text-lg leading-relaxed text-(--muted) sm:text-xl"
            >
                Um lugar para expressar minhas opiniões sobre as coisas que eu
                tenho feito, aprendido e pensado.
            </p>
            
        </div>
    </section>
</BaseLayout>
