---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogItem from "../components/BlogItem.astro";

const allPosts = Object.values(
    import.meta.glob("./posts/*.md", { eager: true }),
);
const tags = [
    ...new Set(allPosts.map((post: any) => post.frontmatter.tags).flat()),
];
---

<BaseLayout pageTitle="Blog">
    <section class="mb-12 max-w-2xl">
        <p
            class="text-sm font-bold tracking-[0.2em] text-(--accent-dark) uppercase"
        >
            Meu diário
        </p>
        <h1
            class="mt-4 font-serif text-6xl leading-[0.92] tracking-tight sm:text-7xl"
        >
            Sobre coisas que eu tenho pensado<span class="text-(--accent)"
                >.</span
            >
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-(--muted)">
            E outras coisitas mais...
        </p>
    </section>
    <section
        class="mb-10 border-y border-(--line) py-5"
        aria-labelledby="available-tags"
    >
        <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
            <h2
                id="available-tags"
                class="m-0 text-sm font-bold tracking-[0.14em] text-(--muted) uppercase"
            >
                Tags
            </h2>
            <div class="flex flex-wrap gap-2">
                {
                    tags.map((tag) => (
                        <a
                            class="rounded-full bg-(--fresh) px-3 py-1 text-sm font-bold text-(--ink) no-underline hover:bg-(--accent) hover:text-(--ink)"
                            href={`/tags/${tag}/`}
                        >
                            #{tag}
                        </a>
                    ))
                }
            </div>
        </div>
    </section>
    <ul class="m-0 grid list-none gap-4 p-0">
        {allPosts.map((post: any) => <BlogItem post={post} />)}
    </ul>
</BaseLayout>
