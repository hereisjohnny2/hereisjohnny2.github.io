---
const { post } = Astro.props;
---

<li
    class="group rounded-2xl border border-(--line) bg-(--panel) p-6 transition-transform hover:-translate-y-1 sm:p-8"
>
    <a
        class="flex items-center justify-between gap-5 font-serif text-3xl text-(--ink) no-underline group-hover:text-(--accent-dark)"
        href={post.url}
    >
        <>
            <span>{post.frontmatter.title}</span>
            <span class="font-sans text-2xl" aria-hidden="true"> ↗ </span>
        </>
    </a>
    <p class="mt-3 mb-0 text-(--muted)">
        {post.frontmatter.description}
    </p>
</li>
