---
import Navigation from "./Navigation.astro";
---

<header
    class="mx-auto flex w-full max-w-5xl items-center justify-between px-5 pt-5 sm:px-8 sm:pt-8"
>
    <a href="/" class="group flex items-center gap-3 no-underline">
        <img
            src="/logo.svg"
            alt=""
            class="size-10 object-contain transition-transform group-hover:-rotate-6"
        >
        <span
            class="text-sm font-bold tracking-[0.18em] text-(--ink) uppercase"
            >Here Is Johnny</span
        >
    </a>
    <div class="flex items-center gap-3">
        <button
            class="theme-toggle"
            type="button"
            aria-label="Switch to dark theme"
            title="Switch to dark theme"
        >
            <span class="theme-icon" aria-hidden="true">☾</span>
        </button>
        <Navigation />
    </div>
</header>
