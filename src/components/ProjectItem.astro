---
interface Props {
    name: string;
    description: string;
    url: string;
}

const { name, description, url } = Astro.props;
---

<article class="group rounded-2xl border border-[var(--line)] bg-[var(--panel)] p-6 transition-transform hover:-translate-y-1 sm:p-8">
    <div class="flex items-start justify-between gap-6">
        <div>
            <p class="mb-3 text-sm font-bold tracking-[0.14em] text-[var(--accent-dark)] uppercase">Projeto pessoal</p>
            <h2 class="font-serif text-3xl leading-tight text-[var(--ink)] sm:text-4xl">{name}</h2>
        </div>
        <span class="grid size-10 shrink-0 place-items-center rounded-full bg-[var(--fresh)] text-xl text-[var(--ink)] transition-transform group-hover:rotate-6" aria-hidden="true">↗</span>
    </div>
    <p class="mt-5 max-w-2xl text-base leading-relaxed text-[var(--muted)]">{description}</p>
    <a class="mt-6 inline-flex items-center gap-2 font-bold text-[var(--ink)] no-underline hover:text-[var(--accent-dark)]" href={url} target="_blank" rel="noreferrer">
        Visitar projeto <span aria-hidden="true">↗</span>
    </a>
</article>
